{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "nativeui",
  "displayName": "NativeUI",
  "description": "Create responsive, dynamic NativeUI apps with complete flows, logic, local tooling, tests, packaging, and releases across native, desktop, and web targets.",
  "version": "0.3.0",
  "author": { "name": "NativeUI" },
  "category": "app-development",
  "keywords": ["nativeui", "ios", "android", "mobile", "design", "backend", "deploy", "html", "pwa", "csharp", "rust", "desktop", "cross-platform"],
  "mcpServers": {
    "nativeui": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/server.mjs"]
    }
  }
}
